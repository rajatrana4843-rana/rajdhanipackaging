# Generated by build.js - edit build.js instead of this file.

Options -MultiViews
RewriteEngine On

# index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

RewriteRule ^about-us\.html$ /about-us/ [R=301,L]
RewriteRule ^shop\.html$ /shop/ [R=301,L]
RewriteRule ^blog\.html$ /blog/ [R=301,L]
RewriteRule ^contact-us\.html$ /contact-us/ [R=301,L]
RewriteRule ^6-types-of-plastic-packaging-pouches-you-should-know\.html$ /6-types-of-plastic-packaging-pouches-you-should-know/ [R=301,L]
RewriteRule ^searching-for-trusted-plastic-pouch-manufacturers-for-your-business\.html$ /searching-for-trusted-plastic-pouch-manufacturers-for-your-business/ [R=301,L]

# Old product / category ids
RewriteRule ^product/flour-packaging-bags/?$ /product/atta-pouch-manufacturer/ [R=301,L]
RewriteRule ^product/royal-phool-makhana-pouch/?$ /product/makhana-pouch-manufacturers/ [R=301,L]
RewriteRule ^product-category/detergent-powder-packaging/?$ /product-category/detergent-powder-pouch-manufacturer/ [R=301,L]

# product.html?id=xyz -> /product/xyz/
RewriteCond %{QUERY_STRING} (?:^|&)id=([a-z0-9-]+)
RewriteRule ^product\.html$ /product/%1/? [R=301,L]

# category.html?category=xyz -> /product-category/xyz/
RewriteCond %{QUERY_STRING} (?:^|&)category=([a-z0-9-]+)
RewriteRule ^category\.html$ /product-category/%1/? [R=301,L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
